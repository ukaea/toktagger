# Copy this file to .env and replace every value marked CHANGE.
# Use letters and digits in passwords. The Mongo password goes into a URL.

# Public host names. Both names must point to this server in DNS.
# Use "localhost" and "keycloak.localhost" to test on one machine.
TOKTAGGER_HOST=toktagger.example.com
KEYCLOAK_HOST=auth.example.com

# CHANGE: random strings, for example from `openssl rand -hex 32`
AUTH_SECRET_KEY=CHANGE
KEYCLOAK_CLIENT_SECRET=CHANGE
KEYCLOAK_ADMIN_PASSWORD=CHANGE
POSTGRES_PASSWORD=CHANGE
MONGO_PASSWORD=CHANGE

MONGO_USERNAME=toktagger
SERVER_WORKERS=4
