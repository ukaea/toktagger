# Existing OpenID Connect provider. Copy this file to .env.
# For bundled Keycloak, copy .env.keycloak.example instead.
COMPOSE_FILE=docker-compose.yml

# Public host name. It must point to this server in DNS.
# Use "localhost" to test on one machine.
TOKTAGGER_HOST=toktagger.example.com

# CHANGE: use the client credentials issued by your identity provider.
AUTH_ISSUER_URL=CHANGE
AUTH_CLIENT_ID=CHANGE
AUTH_CLIENT_SECRET=CHANGE
# AUTH_SCOPES=openid profile email
# AUTH_ROLES_CLAIM=groups
# AUTH_ADMIN_GROUP=toktagger-admins

# CHANGE: random strings, for example from `openssl rand -hex 32`.
# Use letters and digits in the Mongo password; it goes into a URL.
AUTH_SECRET_KEY=CHANGE
MONGO_PASSWORD=CHANGE

MONGO_USERNAME=toktagger
SERVER_WORKERS=4

# Set to "models" to install the optional machine learning packages in the image.
# TOKTAGGER_EXTRAS=models
