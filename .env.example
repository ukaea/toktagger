# Copy this file to .env and replace every value marked CHANGE that your stack uses.
# Use letters and digits in passwords. The Mongo password goes into a URL.

# Bundled Keycloak (default). For an existing IdP, use only docker-compose.yml.
# On Windows, separate file names with ; instead of :.
COMPOSE_FILE=docker-compose.yml:docker-compose.keycloak.yml

# Public host name. It must point to this server in DNS.
# Use "localhost" to test on one machine.
TOKTAGGER_HOST=toktagger.example.com

# CHANGE: random strings, for example from `openssl rand -hex 32`
AUTH_SECRET_KEY=CHANGE
MONGO_PASSWORD=CHANGE

# Bundled Keycloak only. Use "keycloak.localhost" to test on one machine.
KEYCLOAK_HOST=auth.example.com
KEYCLOAK_CLIENT_SECRET=CHANGE
KEYCLOAK_ADMIN_PASSWORD=CHANGE
POSTGRES_PASSWORD=CHANGE

# Existing IdP only. Set COMPOSE_FILE=docker-compose.yml above and configure these.
# AUTH_ISSUER_URL=https://auth.example.com/realms/toktagger
# AUTH_CLIENT_ID=toktagger
# AUTH_CLIENT_SECRET=CHANGE
# AUTH_SCOPES=openid profile email
# AUTH_ROLES_CLAIM=groups
# AUTH_ADMIN_GROUP=toktagger-admins

MONGO_USERNAME=toktagger
SERVER_WORKERS=4

# Set to "models" to install the optional machine learning packages in the image.
# TOKTAGGER_EXTRAS=models
